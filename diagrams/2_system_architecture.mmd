flowchart TD
    subgraph ClientLayer["Presentation Layer (Client)"]
        UI["Next.js 16 Web Application"]
        Canvas["React-Quill Canvas"]
        DiffUI["Diff Engine"]
        ChatUI["Copilot Assistant Panel"]

        Canvas --> UI
        DiffUI --> UI
        ChatUI --> UI
    end

    subgraph APILayer["API Gateway & Application Server"]
        Express["Express.js Server"]
        AuthMid["JWT Auth Middleware"]
        DocCtrl["Document Controller"]
        AICtrl["AI Controller + KeyRotator"]
        QueueCtrl["BullMQ Export Controller"]

        Express --> AuthMid
        AuthMid --> DocCtrl
        AuthMid --> AICtrl
        AuthMid --> QueueCtrl
    end

    subgraph DataLayer["Storage & Queue Layer (Docker Engine)"]
        Mongo[("MongoDB Database")]
        Redis[("Redis Queue Broker")]
        PuppeteerWorker["Puppeteer Headless PDF Engine"]

        Redis --> PuppeteerWorker
    end

    subgraph ExternalCloud["Cloud Services & Security"]
        Doppler["Doppler Secrets Cloud"]
        GeminiCloud["Google Gemini 2.5 Flash API"]
        BrevoCloud["Brevo Transactional Email Service"]
    end

    UI --> Express
    Doppler --> Express
    DocCtrl --> Mongo
    QueueCtrl --> Redis
    AICtrl --> GeminiCloud
    AuthMid --> BrevoCloud
