flowchart TD
    %% Global orthogonal styling
    linkStyle default interpolate stepAfter

    subgraph ClientLayer["Presentation Layer (Client)"]
        direction TB
        UI["Next.js 16 (App Router + Tailwind)"]
        Canvas["React-Quill Canvas (Georgia Serif)"]
        DiffUI["Diff Engine (Additions / Deletions)"]
        ChatUI["Copilot Assistant Panel"]

        Canvas --> UI
        DiffUI --> UI
        ChatUI --> UI
    end

    subgraph APILayer["API Gateway & Application Server"]
        direction TB
        Express["Express.js Server (Node.js TypeScript)"]
        AuthMid["JWT Auth Middleware"]
        DocCtrl["Document Controller (CRUD)"]
        AICtrl["AI Controller + KeyRotator"]
        QueueCtrl["BullMQ Export Controller"]

        Express --> AuthMid
        AuthMid --> DocCtrl
        AuthMid --> AICtrl
        AuthMid --> QueueCtrl
    end

    subgraph DataLayer["Storage & Queue Layer (Docker Engine)"]
        direction TB
        Mongo[("MongoDB (Primary DB)")]
        Redis[("Redis (BullMQ Broker)")]
        PuppeteerWorker["Puppeteer Headless PDF Engine"]

        Redis --> PuppeteerWorker
    end

    subgraph ExternalCloud["Cloud Services & Security"]
        direction TB
        Doppler["Doppler Secrets Cloud"]
        GeminiCloud["Google Gemini 2.5 Flash API"]
        BrevoCloud["Brevo Transactional Email REST API"]
    end

    UI --> Express
    Doppler -.->|"Injects Secrets"| Express
    DocCtrl --> Mongo
    QueueCtrl --> Redis
    AICtrl -->|"Multi-Key Auto-Rotation"| GeminiCloud
    AuthMid -->|"OTP Delivery"| BrevoCloud
