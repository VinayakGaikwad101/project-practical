flowchart TD
    subgraph Navbar["TOP NAVIGATION BAR"]
        direction LR
        Logo["DraftEngine Logo"]
        DocTitle["Document Title Field"]
        SaveStatus["Saved Status Indicator"]
        ExportBtn["[Export PDF] Button"]
        SaveBtn["[Save] Button"]
        Profile["User Profile Circle"]

        Logo --> DocTitle --> SaveStatus --> ExportBtn --> SaveBtn --> Profile
    end

    subgraph CanvasSide["DOCUMENT CANVAS (LEFT PANE)"]
        direction TB
        QuillTools["Quill Toolbar: Bold, Italic, Headers, Lists, Code, Clean"]
        DiffPanel["Proposed Amendments Diff Box: (-) Old Text / (+) New Text"]
        QuillBody["Rich Text Editor Canvas (Georgia Serif Body Text)"]

        QuillTools --> DiffPanel --> QuillBody
    end

    subgraph CopilotSide["AI COPILOT (RIGHT PANE)"]
        direction TB
        CopilotHeader["Assistant Header: Editorial Copilot"]
        MessageHistory["Conversation Message Stream"]
        SelectedChip["Selected Text Card with Action Buttons: Rephrase | Fix Grammar | Summarize"]
        PromptInput["Command Input Field with Send Button"]

        CopilotHeader --> MessageHistory --> SelectedChip --> PromptInput
    end

    Navbar --> CanvasSide
    Navbar --> CopilotSide
