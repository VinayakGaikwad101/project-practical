PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (Local MongoDB or Embedded Fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/ai_document_editor

# Redis Queue (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT & Session Secret
JWT_SECRET=your_jwt_secret_here

# Google Gemini API Keys (Comma-separated for auto-rotation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=your_gemini_api_key_here

# Brevo Transactional Email Service
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@domain.com
